# Copy to .env (local) or set as real environment variables (production).
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=lms.example.com
CORS_ALLOWED_ORIGINS=https://lms.example.com
CSRF_TRUSTED_ORIGINS=https://lms.example.com
SECURE_COOKIES=True
SECURE_SSL_REDIRECT=False
LOG_LEVEL=INFO

DB_ENGINE=django.db.backends.postgresql
DB_NAME=lmsdms_db
DB_USER=lmsdms_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# OnlyOffice: JWT secret must match the document server's configuration.
ONLYOFFICE_SECRET=change-me
ONLYOFFICE_SERVER_URL=http://onlyoffice.internal
# URL at which the OnlyOffice server reaches this backend (media + callback).
BACKEND_PUBLIC_URL=http://backend.internal
# Comma-separated hosts edited documents may be downloaded from (SSRF guard).
ONLYOFFICE_ALLOWED_DOWNLOAD_HOSTS=onlyoffice.internal

LOGIN_MAX_FAILED_ATTEMPTS=3
PASSWORD_EXPIRY_DAYS=90
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
QUIZ_MAX_ATTEMPTS=3
AUTH_THROTTLE_RATE=10/min
REVISION_APPROVER_GROUPS=Doc Admin,Admin
SECURE_HSTS_SECONDS=0
